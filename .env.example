# ZIRA3I_BACKEND_URL: base URL of the Zira3i FastAPI backend (see backend/README.md).
# - Android emulator talking to a backend on your PC: http://10.0.2.2:8000
# - Physical device over USB: run `adb reverse tcp:8000 tcp:8000` and use http://127.0.0.1:8000
# - Deployed backend: https://your-backend.example.com
# The AI provider key (NVIDIA NIM) lives ONLY on the backend, never in the APK.
ZIRA3I_BACKEND_URL=http://10.0.2.2:8000
