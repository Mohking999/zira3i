# NVIDIA NIM API key from https://build.nvidia.com (starts with "nvapi-").
# ZIRA3I_API_KEY is also accepted as an alias.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (comma-separated, tried in order)
# ZIRA3I_TEXT_MODELS=mistralai/mistral-large-2-instruct,nvidia/llama-3.1-nemotron-70b-instruct,google/gemma-3-12b-it
# ZIRA3I_VISION_MODELS=meta/llama-3.2-90b-vision-instruct,meta/llama-3.2-11b-vision-instruct
# ZIRA3I_TIMEOUT_S=60
